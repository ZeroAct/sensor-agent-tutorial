# Copy this file to `.env` (gitignored) and fill in YOUR free-tier values.
# Never commit real keys. Empty OPENAI_API_KEY still starts MQTT + MCP;
# Open WebUI will simply have no model until a key is present.

# --- OpenAI-compatible LLM (required for the chatbot half of the lab) ---
# Groq free tier example:
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_API_MODEL=llama-3.1-8b-instant

# OpenRouter example (pick a free model from their catalog):
# OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_API_MODEL=openai/gpt-4o-mini

# Google AI Studio OpenAI-compatible example:
# OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
# OPENAI_API_MODEL=gemini-2.0-flash

# --- Open WebUI workshop defaults ---
# false = no login (classroom). Do not expose this to a shared company network.
WEBUI_AUTH=false
WEBUI_SECRET_KEY=workshop-only-not-a-real-secret
# Re-read env on every start so .env edits actually apply in class.
ENABLE_PERSISTENT_CONFIG=false

# --- Dummy plant ---
ANOMALY_EVERY_SEC=45
WARNING_RMS_MM_S=4.5
ANOMALY_RMS_MM_S=7.0
PUBLISH_INTERVAL_SEC=2
