{
  "name": "sensor-agent-tutorial",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [8080, 8000, 1883],
  "portsAttributes": {
    "8080": {
      "label": "Open WebUI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "MCP server",
      "onAutoForward": "silent"
    },
    "1883": {
      "label": "MQTT",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash playground/scripts/codespaces-bootstrap.sh",
  "hostRequirements": {
    "memory": "8192"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  }
}
